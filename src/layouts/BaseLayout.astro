---
import '../styles/global.css';
import DisclaimerBanner from '../components/DisclaimerBanner.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { NAV, SITE } from '../lib/site';
import { serializeJsonLd } from '../lib/jsonld';
import { buildTitle, truncateAtWord, breadcrumbLd } from '../lib/seo';

interface Crumb { name: string; path: string }
const { title, description, path, jsonLd, noindex, ogType = 'website', breadcrumbs, author } = Astro.props as {
  title: string; description: string; path: string; jsonLd?: object | object[]; noindex?: boolean;
  ogType?: 'website' | 'article'; breadcrumbs?: Crumb[]; author?: string;
};
const canonical = new URL(path, SITE.url).toString();
const ogImage = new URL('/og/kawal-og.png', SITE.url).toString();
const fullTitle = buildTitle(title, SITE.name, 'Kawal');
const desc = truncateAtWord(description, 160);
const crumbs = breadcrumbs ? [{ name: 'Beranda', path: '/' }, ...breadcrumbs] : [];
const lds = [
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
  ...(crumbs.length > 1 ? [breadcrumbLd(crumbs.map((c) => ({ name: c.name, url: new URL(c.path, SITE.url).toString() })))] : []),
];
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex
      ? <meta name="robots" content="noindex" />
      : <><meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" /><link rel="canonical" href={canonical} /></>}
    <meta name="google-site-verification" content={SITE.googleVerification} />
    <meta name="author" content={author ?? SITE.author} />
    <meta name="theme-color" content="#0a0e1a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Operasi Ababil: kawanan burung ababil membawa batu di langit malam" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    {lds.map((ld) => <script type="application/ld+json" set:html={serializeJsonLd(ld)} />)}
  </head>
  <body>
    <DisclaimerBanner />
    <header class="nav">
      <div class="container">
        <a href="/" class="brand"><img src="/logo-kawal.svg" alt="" width="32" height="32" />{SITE.name}</a>
        <details class="nav__menu" open>
          <summary>Menu</summary>
          <ul class="nav__links">
            {NAV.map((n) => <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
          </ul>
        </details>
      </div>
    </header>
    {crumbs.length > 1 && <Breadcrumbs items={crumbs} />}
    <main><slot /></main>
    <footer class="footer"><div class="container">
      <p>Konten oleh {SITE.author}. Bukan nasihat hukum. Permintaan koreksi: <a href={`mailto:${SITE.correctionsEmail}`}>{SITE.correctionsEmail}</a>.</p>
    </div></footer>
    <script src="/menu.js" defer></script>
  </body>
</html>
