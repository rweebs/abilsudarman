---
interface Crumb { name: string; path: string }
const { items } = Astro.props as { items: Crumb[] };
---
<nav class="breadcrumbs container" aria-label="Jejak halaman">
  <ol>
    {items.map((c, i) => (
      <li>{i === items.length - 1
        ? <span aria-current="page">{c.name}</span>
        : <a href={c.path}>{c.name}</a>}</li>
    ))}
  </ol>
</nav>
