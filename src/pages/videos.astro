---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getVideos } from '../lib/content';
import { sortVideos, thumbSrc, watchUrl } from '../lib/videos';
import { thumbFor } from '../lib/bukti';
import { DISCLAIMER, SITE } from '../lib/site';
const videos = sortVideos(await getVideos());
const DESCRIPTION = 'Daftar video YouTube Rahmat Wibowo tentang klaim Abil Sudarman. Putar langsung di halaman; pemutar YouTube baru dimuat setelah Anda menekan video.';
const ld = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Video YouTube', url: `${SITE.url}/videos`, inLanguage: 'id', description: DESCRIPTION };
---
<BaseLayout title="Video YouTube" description={DESCRIPTION} path="/videos" jsonLd={ld} breadcrumbs={[{ name: 'Videos', path: '/videos' }]}>
  <section class="container pad-block">
    <h1>Videos</h1>
    <p class="muted">{DISCLAIMER}</p>
    <p class="muted">Judul asli video; berisi pendapat penulis, bukan putusan. Pemutar YouTube (pihak ketiga) baru dimuat setelah Anda menekan sebuah video; tanpa itu tidak ada permintaan ke YouTube.</p>
    {videos.length === 0
      ? <p class="muted">Belum ada video yang dipublikasikan.</p>
      : <ul class="video-grid">{videos.map((v) => (
          <li class="card">
            <a class="video-card" href={watchUrl(v.data.youtubeId, v.data.start)} target="_blank" rel="noopener"
               data-video-id={v.data.youtubeId} data-start={v.data.start} data-title={v.data.title}>
              <span class="video-thumb">
                <img src={thumbFor(thumbSrc(v.data.youtubeId))} alt="" width="640" height="360" loading="lazy" decoding="async" />
                <span class="video-play" aria-hidden="true"></span>
              </span>
              <span class="video-title">{v.data.title}</span>
            </a>
          </li>))}</ul>}
  </section>
  <dialog id="video-dialog" class="video-dialog" aria-labelledby="video-dialog-title">
    <div class="video-dialog__body">
      <div class="video-dialog__bar">
        <h2 id="video-dialog-title">Video</h2>
        <button type="button" class="btn video-close">Tutup</button>
      </div>
      <div class="video-stage"></div>
      <p class="muted video-note">Pemutar YouTube (pihak ketiga, privasi-ditingkatkan) dimuat setelah Anda menekan sebuah video dan dihentikan saat jendela ditutup.</p>
    </div>
  </dialog>
  <script>import '../scripts/video-modal';</script>
</BaseLayout>
