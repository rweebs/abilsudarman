---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getQuestions } from '../../lib/content';
const questions = await getQuestions();
---
<BaseLayout title="Pertanyaan" description="Daftar pertanyaan terbuka kepada Abil Sudarman." path="/pertanyaan">
  <section class="container pad-block">
    <h1>Pertanyaan</h1>
    {questions.length === 0
      ? <p class="muted">Belum ada pertanyaan yang dipublikasikan.</p>
      : <div class="grid">{questions.map((q) => (
          <a class="card card--link card-link" href={`/pertanyaan/${q.id}`}>
            <StatusBadge status={q.data.status} /><h2 class="card-title">{q.data.title}</h2><p class="muted">{q.data.question}</p>
          </a>))}</div>}
  </section>
</BaseLayout>
