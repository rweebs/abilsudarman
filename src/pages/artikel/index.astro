---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClassificationBadge from '../../components/ClassificationBadge.astro';
import PostThumb from '../../components/PostThumb.astro';
import { firstImage } from '../../lib/header-image';
import { getPosts } from '../../lib/content';
const posts = await getPosts();
const DESCRIPTION = 'Terjemahan Bahasa Indonesia dari artikel Rahmat Wibowo tentang klaim dan kredensial Abil Sudarman, dengan klasifikasi pendapat, fakta berbukti, dan aduan.';
const ld = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Artikel terjemahan Bahasa Indonesia', url: 'https://abilsudarman.my.id/artikel', inLanguage: 'id', description: DESCRIPTION };
---
<BaseLayout title="Artikel terjemahan Bahasa Indonesia" description={DESCRIPTION} path="/artikel" jsonLd={ld} breadcrumbs={[{ name: 'Artikel', path: '/artikel' }]}>
  <section class="container pad-block">
    <h1>Artikel</h1>
    {posts.length === 0
      ? <p class="muted">Belum ada artikel yang dipublikasikan.</p>
      : <div class="grid">{posts.map((p) => (
          <a class="card card--link card-link" href={`/artikel/${p.id}`}>
            <PostThumb title={p.data.title} slug={p.id} image={firstImage(p.body ?? '')} />
            <ClassificationBadge value={p.data.classification} /><h2 class="card-title">{p.data.title}</h2>
            <p class="muted">Terjemahan dari: {p.data.originalTitle}</p>
          </a>))}</div>}
  </section>
</BaseLayout>
