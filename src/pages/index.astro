---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostThumb from '../components/PostThumb.astro';
import ClassificationBadge from '../components/ClassificationBadge.astro';
import SkyStage from '../components/SkyStage.tsx';
import SpotifyPlayer from '../components/SpotifyPlayer.tsx';
import TiltCard from '../components/motion/TiltCard.tsx';
import { getPosts } from '../lib/content';
import { firstImage } from '../lib/header-image';
import { HOME_SECTIONS } from '../lib/sky/states';
import poskota from '../assets/home/poskota-cyberattack.png';

const posts = (await getPosts()).slice(0, 6);
const SECTIONS = [...HOME_SECTIONS];
const DESCRIPTION = 'Operasi Ababil: kawal terbuka atas klaim Abil Sudarman. Terjemahan artikel, bukti, dan hak jawab, sebagai catatan dan pendapat, bukan putusan.';
const websiteLd = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: 'Kawal Abil Sudarman', alternateName: 'Operasi Ababil',
  url: 'https://abilsudarman.my.id/', inLanguage: 'id', description: DESCRIPTION,
};
const REPORT = 'https://www.pewartanusantara.com/berita/dibungkam-situs-ordal-id-kena-6-000-serangan-siber-usai-bongkar-borok-loker-komdigi/';
---
<BaseLayout title="Operasi Ababil" description={DESCRIPTION} path="/" jsonLd={websiteLd}>
  <SkyStage client:idle sectionIds={SECTIONS} />
  <div class="home-main">
    <section id="operasi" class="home-section container">
      <div class="glass stack">
        <div class="stack">
          <h1>Operasi Ababil</h1>
          <p class="hero-sub">Operasi untuk mengungkap Abil Sudarman</p>
          <p class="lead muted">Seperti kawanan ababil yang membawa batu kecil satu per satu, operasi ini mengumpulkan bukti dan terjemahan artikel secara terbuka. Ini catatan dan pendapat Rahmat Wibowo, bukan putusan. Abil Sudarman berhak menanggapi setiap tulisan.</p>
          <a class="btn" href="/artikel">Baca artikel terjemahan</a>
        </div>
        <SpotifyPlayer client:visible />
      </div>
    </section>

    <section id="siapa" class="home-section container">
      <div class="glass stack">
        <h2>Siapa Abil Sudarman</h2>
        <p class="muted lead">Kreator konten dan konselor karier, menurut pemberitaan. Konteks berikut bukan tuduhan.</p>
        <figure class="figure-quote">
          <Image src={poskota} alt="Tangkapan gambar dari pemberitaan: Abil Sudarman berbicara, dengan teks “6000+ cyberattack sejak siang tadi”" width={520} />
          <figcaption>
            Abil Sudarman melaporkan sekitar 6.000 serangan siber terhadap Ordal.id setelah mengunggah video tentang Komdigi
            (<a href={REPORT} rel="noopener noreferrer" target="_blank">Pewarta Nusantara, 31 Januari 2026</a>).
            Sumber foto: Poskota (tertera pada gambar).
          </figcaption>
        </figure>
      </div>
    </section>

    <section id="bukti" class="home-section container">
      <div class="glass stack">
        <h2>Bukti dan artikel</h2>
        {posts.length === 0
          ? <p class="muted">Belum ada artikel yang dipublikasikan.</p>
          : <div class="grid">{posts.map((p) => (
              <TiltCard client:visible href={`/artikel/${p.id}`}>
                <PostThumb title={p.data.title} slug={p.id} image={firstImage(p.body ?? '')} />
                <ClassificationBadge value={p.data.classification} />
                <h3 class="card-title">{p.data.title}</h3>
              </TiltCard>))}</div>}
      </div>
    </section>

    <section id="jawaban" class="home-section container">
      <div class="glass stack">
        <h2>Jawaban</h2>
        <p class="lead">Abil Sudarman berhak menanggapi, mengoreksi, atau menambahkan konteks atas setiap tulisan di sini.</p>
        <p class="muted lead">Tanggapan yang diterima dimuat apa adanya. Belum adanya tanggapan bukan pengakuan atas apa pun.</p>
        <a class="btn" href="/hak-jawab">Hak jawab</a>
      </div>
    </section>
  </div>
</BaseLayout>
