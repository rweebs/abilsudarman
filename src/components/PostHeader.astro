---
import { hueFromSlug } from '../lib/header-image';
const { title, slug, image } = Astro.props as { title: string; slug: string; image: { src: string; alt: string } | null };
const hueClass = `hue-${Math.floor(hueFromSlug(slug) / 30)}`;
const alt = image && image.alt && image.alt !== 'Isi artikel' ? image.alt : title;
---
<figure class="post-header" data-post-header>
  {image
    ? <img src={image.src} alt={alt} loading="eager" decoding="async" />
    : <div class={`post-header__fallback ${hueClass}`} role="img" aria-label={title}></div>}
</figure>
