---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import TiltCard from '../../components/motion/TiltCard.tsx';
import { getQuestions } from '../../lib/content';
const items = await getQuestions();
const DESCRIPTION = 'Daftar butir kawal terbuka atas klaim Abil Sudarman: setiap butir memuat dugaan, bukti, status pengiriman, dan ruang untuk jawaban apa adanya.';
const ld = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Butir kawal atas klaim Abil Sudarman', url: 'https://abilsudarman.my.id/kawal', inLanguage: 'id', description: DESCRIPTION };
---
<BaseLayout title="Butir kawal atas klaim Abil Sudarman" description={DESCRIPTION} path="/kawal" jsonLd={ld} breadcrumbs={[{ name: 'Kawal', path: '/kawal' }]}>
  <section class="container pad-block">
    <h1>Kawal Abil Sudarman</h1>
    {items.length === 0
      ? <p class="muted">Belum ada butir kawal yang dipublikasikan.</p>
      : <div class="grid">{items.map((q) => (
          <TiltCard client:visible href={`/kawal/${q.id}`}>
            <StatusBadge status={q.data.status} /><h2 class="card-title">{q.data.title}</h2><p class="muted">{q.data.question}</p>
          </TiltCard>))}</div>}
  </section>
</BaseLayout>
