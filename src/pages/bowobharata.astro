---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BowobharataStage from '../components/BowobharataStage.astro';
import wide from '../assets/bowobharata/poster-wide.jpg';
import krishna from '../assets/bowobharata/krishna.jpg';
import sengkuni from '../assets/bowobharata/sengkuni.jpg';
import { FRAMING, PAGE, PARVAS, POSTERS, parvaEvents } from '../lib/bowobharata';
import { eventUrl, formatDate } from '../lib/linimasa';
import { DISCLAIMER, SITE } from '../lib/site';
const ld = { '@context': 'https://schema.org', '@type': 'WebPage', name: PAGE.title, url: `${SITE.url}/bowobharata`, inLanguage: 'id', description: PAGE.description };
---
<BaseLayout title={PAGE.title} description={PAGE.description} path="/bowobharata" jsonLd={ld} breadcrumbs={[{ name: 'Bowobharata', path: '/bowobharata' }]}>
  <BowobharataStage />
  <div class="bb-main">
    <header>
      <p class="eyebrow">{PAGE.kicker}</p>
      <h1>{PAGE.title}: Kebenaran vs Pembenaran</h1>
      <p>{PAGE.lead}</p>
    </header>
    <p class="muted">{DISCLAIMER}</p>

    <section class="bb-note callout" aria-label="Catatan tentang halaman ini">
      {FRAMING.map((t) => <p>{t}</p>)}
      <ul class="bb-links">
        <li><a href="/bukti">Bukti</a></li>
        <li><a href="/linimasa">Linimasa</a></li>
        <li><a href="/hak-jawab">Hak jawab</a></li>
      </ul>
    </section>

    <figure class="bb-hero bb-reveal">
      <Image src={wide} alt={POSTERS.wide.alt} widths={[480, 720, 1088]} sizes="(max-width: 1120px) calc(100vw - 2rem), 1088px" quality={55} format="webp" loading="eager" fetchpriority="high" />
    </figure>

    <div class="bb-duo">
      <figure class="bb-reveal">
        <Image src={krishna} alt={POSTERS.krishna.alt} widths={[400, 640]} sizes="(max-width: 700px) 100vw, 540px" quality={60} format="webp" />
      </figure>
      <figure class="bb-reveal">
        <Image src={sengkuni} alt={POSTERS.sengkuni.alt} widths={[400, 640]} sizes="(max-width: 700px) 100vw, 540px" quality={60} format="webp" />
      </figure>
    </div>

    <div id="parvas" class="bb-parvas">
      {PARVAS.map((p) => (
        <section id={p.id} class="bb-parva" aria-labelledby={`${p.id}-h`}>
          <div class="glass bb-reveal">
            <p class="eyebrow">Parva {p.number}</p>
            <h2 id={`${p.id}-h`}>{p.title}</h2>
            <p class="bb-episode">{p.episode}</p>
            {p.paragraphs.map((t) => <p>{t}</p>)}
            <ul class="bb-events">
              {parvaEvents(p).map((e) => (
                <li><time datetime={e.date}>{formatDate(e.date)}</time><a href={eventUrl(e)}>{e.title}</a></li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </div>

    <p class="muted">Seluruh halaman ini adalah kiasan dan pendapat saya. Koreksi atau jawaban: <a href="/hak-jawab">Hak jawab</a> atau <a href={`mailto:${SITE.correctionsEmail}`}>{SITE.correctionsEmail}</a>.</p>
  </div>
</BaseLayout>
