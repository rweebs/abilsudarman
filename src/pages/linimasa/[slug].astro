---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { EVENTS, eventUrl, formatDate, neighbours } from '../../lib/linimasa';
import { DISCLAIMER, SITE } from '../../lib/site';

export function getStaticPaths() {
  return EVENTS.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}
const { event } = Astro.props;
const { prev, next } = neighbours(event.slug);
const path = eventUrl(event);
const plain = event.paragraphs[0].replace(/["']/g, '');
const description = plain.length > 155 ? `${plain.slice(0, plain.lastIndexOf(' ', 155))}…` : plain;
const ld = {
  '@context': 'https://schema.org', '@type': 'Article', inLanguage: 'id', headline: event.title.slice(0, 110), description,
  datePublished: event.date, dateModified: event.date,
  author: { '@type': 'Person', name: SITE.author }, publisher: { '@type': 'Person', name: SITE.author },
  mainEntityOfPage: `${SITE.url}${path}`,
};
---
<BaseLayout title={event.title} description={description} path={path} jsonLd={ld}
  breadcrumbs={[{ name: 'Linimasa', path: '/linimasa' }, { name: formatDate(event.date), path }]}>
  <article class="reading linimasa-post">
    <p class="linimasa-meta"><time datetime={event.date}>{formatDate(event.date)}</time> · {event.channel}</p>
    <h1>{event.title}</h1>
    <p class="muted">{DISCLAIMER}</p>
    <p class="linimasa-note">Abil Sudarman dan pihak lain yang disebut berhak menjawab lewat <a href="/hak-jawab">hak jawab</a>.</p>
    {event.paragraphs.map((p) => <p>{p}</p>)}

    {event.sources.length > 0 && (
      <section aria-labelledby="sumber-h">
        <h2 id="sumber-h">Sumber</h2>
        <ul>{event.sources.map((s) => <li><a href={s.url} rel="noopener nofollow" target="_blank">{s.label}</a></li>)}</ul>
        <p class="muted">Tautan mengarah ke kiriman asli saya. Jika ada yang berubah atau dihapus, beri tahu saya.</p>
      </section>
    )}
    {event.related.length > 0 && (
      <section aria-labelledby="terkait-h">
        <h2 id="terkait-h">Terkait di situs ini</h2>
        <ul>{event.related.map((r) => <li><a href={r.href}>{r.label}</a></li>)}</ul>
      </section>
    )}

    <nav class="linimasa-nav" aria-label="Entri berikutnya">
      {prev ? <a href={eventUrl(prev)} rel="prev">← {prev.title}</a> : <span></span>}
      {next ? <a href={eventUrl(next)} rel="next">{next.title} →</a> : <span></span>}
    </nav>
    <p><a href="/linimasa">← Semua entri linimasa</a></p>
  </article>
</BaseLayout>
