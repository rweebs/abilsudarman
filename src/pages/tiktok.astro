---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTiktok } from '../lib/content';
import { sortTiktok, thumbSrc, watchUrl, TIKTOK_CAPTION } from '../lib/tiktok';
import { thumbFor, thumbSrcset } from '../lib/bukti';
import { DISCLAIMER, SITE } from '../lib/site';
const videos = sortTiktok(await getTiktok());
const DESCRIPTION = 'Daftar video TikTok Rahmat Wibowo tentang klaim Abil Sudarman. Putar langsung di halaman; pemutar TikTok baru dimuat setelah Anda menekan video.';
const ld = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Video TikTok', url: `${SITE.url}/tiktok`, inLanguage: 'id', description: DESCRIPTION };
const TIKTOK_SIZES = '(min-width: 768px) 220px, 50vw';
---
<BaseLayout title="Video TikTok" description={DESCRIPTION} path="/tiktok" jsonLd={ld} breadcrumbs={[{ name: 'TikTok', path: '/tiktok' }]}>
  <section class="container pad-block">
    <h1>TikTok</h1>
    <p class="muted">{DISCLAIMER}</p>
    <p class="muted">Seri video TikTok @rweebs_ dengan keterangan: “{TIKTOK_CAPTION}”. Isinya pendapat penulis, bukan putusan. Pemutar TikTok (pihak ketiga) baru dimuat setelah Anda menekan sebuah video; tanpa itu tidak ada permintaan ke TikTok.</p>
    {videos.length === 0
      ? <p class="muted">Belum ada video yang dipublikasikan.</p>
      : <ul class="video-grid tiktok-grid">{videos.map((v) => (
          <li class="card">
            <a class="video-card" href={watchUrl(v.data.tiktokId)} target="_blank" rel="noopener"
               data-tiktok-id={v.data.tiktokId} data-title={v.data.title}>
              <span class="video-thumb">
                <img src={thumbFor(thumbSrc(v.data.tiktokId))} srcset={thumbSrcset(thumbSrc(v.data.tiktokId))} sizes={TIKTOK_SIZES} alt="" width="320" height="569" loading="lazy" decoding="async" />
                <span class="video-play" aria-hidden="true"></span>
              </span>
              <span class="video-title">{v.data.title}</span>
            </a>
          </li>))}</ul>}
  </section>
  <dialog id="video-dialog" class="video-dialog video-dialog--tiktok" aria-labelledby="video-dialog-title">
    <div class="video-dialog__body">
      <div class="video-dialog__bar">
        <h2 id="video-dialog-title">Video</h2>
        <button type="button" class="btn video-close">Tutup</button>
      </div>
      <div class="video-stage"></div>
      <p class="muted video-note">Pemutar TikTok (pihak ketiga) dimuat setelah Anda menekan sebuah video dan dihentikan saat jendela ditutup. TikTok kadang membatasi pemutarnya sementara (“overload-protect triggered”); jika video tidak muncul, muat ulang atau buka langsung di TikTok.</p>
      <p class="video-fallback">
        <button type="button" class="btn video-reload">Muat ulang</button>
        <a class="btn video-open" href="https://www.tiktok.com/" target="_blank" rel="noopener">Buka di TikTok</a>
      </p>
    </div>
  </dialog>
  <script>import '../scripts/tiktok-modal';</script>
</BaseLayout>
