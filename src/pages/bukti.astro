---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBukti } from '../lib/content';
import { groupBukti, sourceLine, thumbFor } from '../lib/bukti';
import { DISCLAIMER, SITE } from '../lib/site';
const groups = groupBukti(await getBukti());
const DESCRIPTION = 'Tangkapan layar yang relevan dengan klaim Abil Sudarman, masing-masing dengan keterangan apa yang terlihat.';
const ld = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Bukti dan tangkapan layar', url: `${SITE.url}/bukti`, inLanguage: 'id', description: DESCRIPTION };
---
<BaseLayout title="Bukti dan tangkapan layar" description={DESCRIPTION} path="/bukti" jsonLd={ld} breadcrumbs={[{ name: 'Bukti', path: '/bukti' }]}>
  <section class="container pad-block">
    <h1>Bukti</h1>
    <p class="muted">{DISCLAIMER}</p>
    <p class="muted">Gambar di bawah menunjukkan klaim sebagaimana dipublikasikan dan catatan yang dapat diperiksa. Gambar bukan putusan. Nomor identitas ditutup.</p>
    {groups.length === 0
      ? <p class="muted">Belum ada bukti yang dipublikasikan.</p>
      : groups.map((g) => (
        <section class="bukti-group" aria-labelledby={`grup-${g.id}`}>
          <h2 id={`grup-${g.id}`}>{g.label}</h2>
          <div class="grid bukti-grid">
            {g.items.map((e) => (
              <article class="card bukti-item">
                <a class="bukti-thumb" href={e.data.images[0].src} target="_blank" rel="noopener">
                  <img src={thumbFor(e.data.images[0].src)} alt={e.data.images[0].alt} width="640" loading="lazy" decoding="async" />
                </a>
                <h3>{e.data.title}</h3>
                <p><strong>Menunjukkan:</strong> {e.data.shows}</p>
                <p class="bukti-source">{sourceLine(e.data)}{e.data.sourceUrl && <> <a href={e.data.sourceUrl} rel="noopener nofollow">Tautan sumber</a></>}</p>
                {e.data.images.length > 1 && (
                  <p class="bukti-more">{e.data.images.slice(1).map((im, i) => (
                    <a href={im.src} target="_blank" rel="noopener" aria-label={im.alt}>Gambar {i + 2}</a>
                  ))}</p>
                )}
              </article>
            ))}
          </div>
        </section>
      ))}
  </section>
</BaseLayout>
