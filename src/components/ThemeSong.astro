---
import { musicUrl, shouldAutoplay, songFor } from '../lib/theme-song';
interface Props { path: string }
const { path } = Astro.props;
const song = songFor(path);
---
<div class="theme-song" data-theme-song data-video-id={song.videoId} data-title={`${song.title} · ${song.artist}`} data-autoplay={shouldAutoplay(path) ? 'true' : 'false'}>
  <section id="theme-song-panel" class="theme-song__panel" aria-label="Lagu tema" data-open="false">
    <p class="theme-song__title">Lagu: {song.title} · {song.artist}</p>
    <div class="theme-song__stage"></div>
    <div class="theme-song__actions">
      <button type="button" class="btn theme-song__stop">Berhenti</button>
      <a class="btn" href={musicUrl(song.videoId)} target="_blank" rel="noopener noreferrer">Buka di YouTube Music</a>
    </div>
    <p class="muted theme-song__note">
      {shouldAutoplay(path)
        ? 'Pemutar YouTube (pihak ketiga) dimuat setelah sentuhan, klik, atau tombol pertama Anda di halaman ini, karena peramban memblokir suara otomatis. Lagu berulang dan berhenti saat Anda pindah halaman.'
        : 'Pemutar YouTube (pihak ketiga) baru dimuat setelah Anda menekan tombol. Lagu berulang otomatis dan berhenti saat Anda pindah halaman.'}
    </p>
  </section>
  <button type="button" class="theme-song__toggle" aria-expanded="false" aria-controls="theme-song-panel">
    <span class="theme-song__icon" aria-hidden="true">♪</span>
    <span class="theme-song__label">Lagu tema</span>
  </button>
</div>
<script>import '../scripts/theme-song';</script>
