---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EVENTS, groupByMonth, formatDate, eventUrl } from '../lib/linimasa';
import { DISCLAIMER, SITE } from '../lib/site';
const groups = groupByMonth();
const DESCRIPTION = 'Catatan berurutan waktu tentang apa yang ditulis, dikirim, dan dilakukan Rahmat Wibowo terkait klaim Abil Sudarman, termasuk unggahan yang keras bahasanya. Setiap entri punya halaman sendiri dan tautan sumber.';
const first = EVENTS[0];
const last = EVENTS[EVENTS.length - 1];
const ld = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Linimasa', url: `${SITE.url}/linimasa`, inLanguage: 'id', description: DESCRIPTION };
const excerpt = (s: string) => (s.length > 220 ? `${s.slice(0, s.lastIndexOf(' ', 220))}…` : s);
---
<BaseLayout title="Linimasa" description={DESCRIPTION} path="/linimasa" jsonLd={ld} breadcrumbs={[{ name: 'Linimasa', path: '/linimasa' }]}>
  <article class="reading linimasa">
    <h1>Linimasa</h1>
    <p class="muted">{DISCLAIMER}</p>
    <p>Ini catatan saya sendiri, berurutan waktu, tentang apa yang saya tulis, kirim, dan lakukan terkait klaim Abil Sudarman, dari {formatDate(first.date)} sampai {formatDate(last.date)}. Saya menyusunnya dari kiriman publik saya agar siapa pun dapat menilai urutan dan isinya sendiri.</p>
    <p>Saya menuliskannya apa adanya, termasuk unggahan yang bahasanya keras, ancaman jalur hukum, dan balasan berulang di Threads yang bisa terasa mengganggu. Saya tidak berniat merundung; tujuan saya adalah memeriksa klaim secara terbuka. Tetapi niat tidak menghapus dampak, karena itu saya mencatat semuanya agar bisa dikritik. Isinya adalah pendapat saya, bukan putusan. Abil Sudarman berhak menjawab, dan jawabannya akan saya muat apa adanya lewat <a href="/hak-jawab">hak jawab</a>.</p>
    <p class="muted">Catatan ini tidak memuat setiap kiriman: kiriman yang sama yang muncul beberapa kali digabung, dan kiriman yang tidak menyebut Abil Sudarman tidak dimasukkan. Tautan sumber mengarah ke kiriman asli. Jika ada yang berubah atau dihapus, saya akan memperbarui halamannya.</p>

    {groups.map((g) => (
      <section class="linimasa-month" aria-labelledby={`bulan-${g.label.replace(/\s+/g, '-').toLowerCase()}`}>
        <h2 id={`bulan-${g.label.replace(/\s+/g, '-').toLowerCase()}`}>{g.label}</h2>
        <ol class="linimasa-list">
          {g.items.map((e) => (
            <li class="linimasa-item">
              <p class="linimasa-meta"><time datetime={e.date}>{formatDate(e.date)}</time> · {e.channel}</p>
              <h3><a href={eventUrl(e)}>{e.title}</a></h3>
              <p>{excerpt(e.paragraphs[0])}</p>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </article>
</BaseLayout>
