---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import DeliveryAddress from '../../components/DeliveryAddress.astro';
import { assertEvidencePublished } from '../../lib/publish';
import { getQuestions, INCLUDE_DRAFTS } from '../../lib/content';

export async function getStaticPaths() {
  return (await getQuestions()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const q = entry.data;
const { Content } = await render(entry);
const posts = await Promise.all(q.evidence.map((id: string) => getEntry('posts', id)));
assertEvidencePublished(
  entry.id,
  q.evidence,
  (id) => posts.find((p) => p?.id === id)?.data,
  INCLUDE_DRAFTS,
);
const evidence = posts.filter((p): p is NonNullable<typeof p> => Boolean(p));
const pagePath = `/kawal/${entry.id}`;
const ld = {
  '@context': 'https://schema.org', '@type': 'WebPage', name: q.title, description: q.question, inLanguage: 'id',
  url: `https://abilsudarman.my.id${pagePath}`,
  isPartOf: { '@type': 'WebSite', name: 'Kawal Abil Sudarman', url: 'https://abilsudarman.my.id/' },
  ...(q.sentDate ? { datePublished: q.sentDate.toISOString().slice(0, 10) } : {}),
};
const fmt = (d?: Date) => d?.toLocaleDateString('id-ID', { dateStyle: 'long' });
---
<BaseLayout title={q.title} description={q.question} path={pagePath} jsonLd={ld} breadcrumbs={[{ name: 'Kawal', path: '/kawal' }, { name: q.title, path: pagePath }]}>
  <article class="reading">
    <StatusBadge status={q.status} />
    <h1>{q.title}</h1>
    <h2>Yang ditanyakan</h2>
    <p>{q.question}</p>
    <h2>Dugaan yang mendasari</h2>
    <p class="muted">Berikut dugaan menurut Rahmat Wibowo, bukan fakta yang telah dibuktikan di pengadilan: {q.allegation}</p>
    <Content />
    {evidence.length > 0 && <>
      <h2>Bukti dan bacaan terkait</h2>
      <ul>{evidence.map((p) => <li><a href={`/artikel/${p.id}`}>{p.data.title}</a></li>)}</ul></>}
    <h2>Pengiriman</h2>
    {q.sentDate
      ? <p>Dikirim {fmt(q.sentDate)} melalui {(q.deliveryChannel ?? []).map((c: string) => (c === 'email' ? 'email' : 'surat')).join(' dan ')}.</p>
      : <p class="muted">Belum dikirim.</p>}
    <DeliveryAddress />
    <h2>Jawaban</h2>
    {q.status === 'dijawab'
      ? <><blockquote class="pre-wrap">{q.reply}</blockquote><p class="muted">Dimuat apa adanya pada {fmt(q.replyDate)}.</p></>
      : <p class="muted">Belum ada jawaban{(q.lastCheckedDate ?? q.sentDate) ? ` per ${fmt(q.lastCheckedDate ?? q.sentDate)}` : ''}. Jawaban yang diterima akan dimuat apa adanya. Lihat <a href="/hak-jawab">hak jawab</a>.</p>}
  </article>
</BaseLayout>
